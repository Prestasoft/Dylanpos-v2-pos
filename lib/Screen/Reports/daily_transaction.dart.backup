                      */
                      // Métricas con diseño Wrap responsivo
                      Consumer(builder: (_, ref, __) {
                        final summary = DailySummaryModel.fromDailyTransactions(reTransaction);
                        
                        return LayoutBuilder(
                          builder: (context, constraints) {
                            // Calcular ancho dinámico para las tarjetas
                            final availableWidth = constraints.maxWidth;
                            double cardWidth;
                            
                            if (availableWidth > 1200) {
                              cardWidth = (availableWidth - 80) / 4; // 4 por fila en pantallas grandes
                            } else if (availableWidth > 800) {
                              cardWidth = (availableWidth - 60) / 3; // 3 por fila en pantallas medianas
                            } else {
                              cardWidth = (availableWidth - 40) / 2; // 2 por fila en pantallas pequeñas
                            }
                            
                            return Wrap(
